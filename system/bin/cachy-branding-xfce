#!/usr/bin/env bash
# Cachy-Void — Xfce applier (tier 2, branding.md §5.13).
#
# An applier's job is to cover what the desktop does NOT provide. Xfce provides
# a great deal: panel, window manager, desktop, file manager, terminal, session,
# notifications, power management. So this is a SMALL applier, closer to Plasma's
# than to the Openbox one — it points Xfce's own machinery at our palette and
# then gets out of the way.
#
# What made it small is a set of facts measured from a real Xfce install rather
# than assumed, and each one removed work:
#
#   * Xfce configuration is xfconf: typed properties in per-channel XML under
#     ~/.config/xfce4/xfconf/xfce-perchannel-xml/, with defaults shipped in
#     /etc/xdg/xfce4/. Changes apply LIVE — xfconf notifies its listeners — so
#     unlike the Plasma applier there is no shell to restart and no cache to
#     bust. Nothing here kills a running process.
#   * xfwm4 window decorations are BITMAPS (per-part PNG/XPM in a theme's
#     xfwm4/ directory), not a colour string like Openbox's themerc or an SVG
#     like Plasma's frame. Authoring them would have been the expensive part —
#     except Arc-Dark, the GTK theme the shared half already selects, ships an
#     xfwm4/ directory of its own. So the titlebars come free by pointing xfwm4
#     at the same theme name as GTK. Playing with the desktop, not against it.
#   * xfce4-terminal takes its font from XSETTINGS (/Gtk/MonospaceFontName) and
#     its palette from the same key names its stock .theme files use. So the
#     terminal needs no rc surgery: set the xsettings font, ship a colour scheme
#     the way the qterminal one is shipped (system dir, deploy.sh's job), and
#     write the palette keys into terminalrc so it is applied rather than merely
#     offered in a dialog.
#
# There is no fallback that writes channel XML directly, and the reason is worth
# recording because the first reason given for it was wrong.
#
# A container test appeared to show that hand-written channel files are ignored
# by xfconfd. That test is not trustworthy: the same container's xfconfd never
# persisted anything either, so it was a broken daemon rather than a fair trial.
# On real hardware xfconfd DOES own those files — every channel this applier
# touches was found rewritten under ~/.config/xfce4/xfconf/xfce-perchannel-xml/
# moments after the run.
#
# Which is precisely why writing them by hand is still the wrong idea: the
# daemon holds channel state in memory and flushes it out, so an edit made while
# a session is running is racing a writer that will win. The live path is
# correct on its own merits, not because the file path was proven closed. So:
# this applier needs a live xfconf, meaning it runs inside an Xfce session — the
# way cachy-branding is already documented to be used — and without one it
# writes what it can, arms a one-shot for the next login, and says so.
#
# VERIFIED on real hardware (nested Xfce session, 2026-08-26): every property
# above lands and reads back, the per-monitor wallpaper path resolves against
# the session's own monitor name, and the panel accepts its background colour
# through xfconf. Still unverified: whether the panel REPAINTS without a
# restart, which is a look question rather than a state one.
set -uo pipefail

ASSETS="${CACHY_BRANDING_ASSETS:-/usr/share/cachy-void/branding}"
CFG="$HOME/.config"; SHARE="$HOME/.local/share"
XFCONF="$CFG/xfce4/xfconf/xfce-perchannel-xml"

# The canonical palette (branding.md §2). Hex here, because every Xfce surface
# that takes a colour takes it as a string, unlike Plasma's r,g,b triples.
BG="#1b1d1e"        # obsidian
PANEL="#282c34"     # graphite
FG="#abb2bf"        # grey-white
ACCENT="#478061"    # "the Void" green
DIM="#5c6370"       # muted text

C=$'\033[38;2;71;128;97m'; W=$'\033[38;2;150;121;64m'; Z=$'\033[0m'
log(){ printf '%s==>%s %s\n' "$C" "$Z" "$*"; }
ok(){  printf '%s ok%s %s\n' "$C" "$Z" "$*"; }
warn(){ printf '%s warn%s %s\n' "$W" "$Z" "$*" >&2; }

# Is Xfce the session we are actually inside? The same gate the other appliers
# learned the hard way: applying a look from a DIFFERENT desktop must write
# config and stop, never start or restart that desktop's programs.
LIVE=false
case "${XDG_CURRENT_DESKTOP:-}" in *XFCE*|*Xfce*|*xfce*) LIVE=true ;; esac

# xfconf-query needs a session bus and a running xfconfd. When that is missing
# (provisioning from a TTY, a container, applying before first login) the same
# properties are written straight into the channel XML, which xfconf reads at
# session start. Both paths exist because both situations are normal.
HAVE_XFCONF=false
if command -v xfconf-query >/dev/null 2>&1 &&
   [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] &&
   xfconf-query -c xsettings -l >/dev/null 2>&1; then
    HAVE_XFCONF=true
fi

# ---------------------------------------------------------------- xfconf write
# xq CHANNEL PROPERTY TYPE VALUE — the ONLY way settings go in.
#
# There is deliberately no file-writing fallback. See the header: hand-written
# channel XML is ignored by xfconfd, so a fallback that appeared to work would
# have quietly done nothing on exactly the boxes it existed for. Refusing
# loudly is worth more than pretending.
XQ_FAILED=0
xq() {
    local chan="$1" prop="$2" type="$3" val="$4"
    $HAVE_XFCONF || { XQ_FAILED=$((XQ_FAILED + 1)); return 1; }
    xfconf-query -c "$chan" -p "$prop" -n -t "$type" -s "$val" 2>/dev/null && return 0
    warn "xfconf-query failed for $chan$prop"
    XQ_FAILED=$((XQ_FAILED + 1))
    return 1
}

# arm_first_login — re-run this applier the next time Xfce actually starts.
# The mechanism the Plasma applier already uses for a setting that cannot be
# written from outside the session; here it covers the whole applier, because
# without xfconf nothing settings-shaped can be written at all.
arm_first_login() {
    mkdir -p "$CFG/autostart"
    printf '[Desktop Entry]\nType=Application\nName=Cachy-Void look (first Xfce login)\nExec=sh -c "cachy-branding-xfce; rm -f %s/autostart/cachy-void-xfce-firstrun.desktop"\nOnlyShowIn=XFCE;\nX-GNOME-Autostart-enabled=true\n' \
        "$CFG" > "$CFG/autostart/cachy-void-xfce-firstrun.desktop"
}

# ------------------------------------------------------------------- --remove
# Reversible, like every other applier here. Settings are RESET (xfconf-query
# -r), which drops the user override and lets Xfce fall back to its own default,
# rather than guessing what the value used to be. The terminalrc is restored
# from the backup taken on first apply; the autostart entries are ours and go.
if [ "${1:-}" = "--remove" ]; then
    log "removing the Cachy-Void Xfce look"
    if $HAVE_XFCONF; then
        for _pp in /Net/ThemeName /Net/IconThemeName /Gtk/FontName /Gtk/MonospaceFontName; do
            xfconf-query -c xsettings -p "$_pp" -r 2>/dev/null
        done
        for _pp in /general/theme /general/title_font; do
            xfconf-query -c xfwm4 -p "$_pp" -r 2>/dev/null
        done
        xfconf-query -c xfce4-desktop -p /desktop-icons/style -r 2>/dev/null
        xfconf-query -c xfce4-panel -p /plugins/plugin-1/button-icon -r 2>/dev/null
        xfconf-query -c xfce4-panel -p /plugins/plugin-1/show-button-title -r 2>/dev/null
        # The dock launcher we added: drop its directory. The plugin id and the
        # panel array are left alone deliberately — Xfce tolerates a missing
        # launcher (it drops the item) and rewriting its arrays on the way OUT is
        # more risk than the tidiness is worth. The pager is not restored either:
        # putting a plugin back is a layout edit, and removal should not perform
        # layout edits of its own.
        for _d in "$CFG"/xfce4/panel/launcher-*; do
            [ -f "$_d/cachy-updater.desktop" ] && rm -rf "$_d"
        done
        xfconf-query -c xfce4-panel -p /panels/panel-1/background-style -r 2>/dev/null
        xfconf-query -c xfce4-panel -p /panels/panel-1/background-rgba -r 2>/dev/null
        # The wallpaper is per-monitor, so reset whatever monitors exist now.
        if command -v xrandr >/dev/null 2>&1; then
            for _m in $(xrandr --listmonitors 2>/dev/null | awk 'NR>1 {print $NF}'); do
                xfconf-query -c xfce4-desktop \
                    -p "/backdrop/screen0/monitor$_m/workspace0/last-image" -r 2>/dev/null
            done
        fi
        ok "xfconf settings reset to Xfce's own defaults"
    else
        warn "no live xfconf — settings could not be reset; run this inside Xfce"
    fi
    if [ -f "$CFG/xfce4/terminal/terminalrc.pre-cachy.bak" ]; then
        mv -f "$CFG/xfce4/terminal/terminalrc.pre-cachy.bak" \
              "$CFG/xfce4/terminal/terminalrc"
        ok "terminalrc restored from backup"
    else
        rm -f "$CFG/xfce4/terminal/terminalrc"
        ok "terminalrc removed (there was none before us)"
    fi
    rm -f "$CFG/autostart/cachy-void-pasystray-xfce.desktop" \
          "$CFG/autostart/cachy-void-udiskie-xfce.desktop"
    if $HAVE_XFCONF; then
        xfconf-query -c xfce4-panel -p /panels/panel-1/position-locked -r 2>/dev/null
        xfconf-query -c xfce4-panel -p /panels/panel-2/position-locked -r 2>/dev/null
    fi
    rm -f "$CFG/autostart/cachy-void-conky-xfce.desktop" \
          "$CFG/autostart/cachy-void-xfce-firstrun.desktop" \
          "$CFG/autostart/cachy-void-xfce-wallpaper.desktop"
    rm -f "$SHARE/cachy-void/wallpaper-xfce.png" \
          "$SHARE/cachy-void/void-cachy-updater.png"
    # Only the names WE added; the rest of Luv-Void belongs to the shared half.
    if [ -d "$SHARE/icons/Luv-Void" ]; then
        find "$SHARE/icons/Luv-Void" -name 'org.xfce.*' -type l -delete 2>/dev/null
        if [ -f "$SHARE/icons/Luv-Void/icon-theme.cache" ] &&
           command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -f -t "$SHARE/icons/Luv-Void" >/dev/null 2>&1
        fi
        ok "Xfce icon aliases removed from Luv-Void (cache refreshed)"
    fi
    ok "removed - log out and back in for a full reset."
    exit 0
fi

log "Cachy-Void Xfce applier"
if ! $HAVE_XFCONF; then
    warn "no live xfconf here (needs a session bus and xfconfd), so the settings"
    warn "  cannot be written now — arming a one-shot that applies them at your"
    warn "  next Xfce login. Nothing else about this run changes."
    arm_first_login
fi
$LIVE || warn "not an Xfce session — nothing is started or restarted"

# ------------------------------------------------------------------ 1. themes
# Both names deliberately the same string: Arc-Dark ships gtk-3.0/ AND xfwm4/,
# so one theme dresses the widgets and the titlebars. Falling back to
# Adwaita-dark keeps the widgets dark on a box without arc-theme, at the cost of
# stock titlebars — which is the honest degradation, not a broken look.
GTK_THEME="Adwaita-dark"
[ -d /usr/share/themes/Arc-Dark ] && GTK_THEME="Arc-Dark"
ICON_THEME="Papirus-Dark"
[ -d "$SHARE/icons/Luv-Void" ] && ICON_THEME="Luv-Void"

_f0=$XQ_FAILED
xq xsettings /Net/ThemeName string "$GTK_THEME"
xq xsettings /Net/IconThemeName string "$ICON_THEME"
xq xsettings /Gtk/FontName string "Hack 10"
# xfce4-terminal reads its font from here, not from terminalrc (measured).
xq xsettings /Gtk/MonospaceFontName string "Hack 10"
if [ "$XQ_FAILED" -eq "$_f0" ]; then
    ok "widgets -> $GTK_THEME, icons -> $ICON_THEME, fonts -> Hack 10"
else
    warn "widgets/icons/fonts: queued for the next Xfce login"
fi

if [ -d "/usr/share/themes/$GTK_THEME/xfwm4" ]; then
    _f0=$XQ_FAILED
    xq xfwm4 /general/theme string "$GTK_THEME"
    xq xfwm4 /general/title_font string "Hack Bold 9"
    if [ "$XQ_FAILED" -eq "$_f0" ]; then
        ok "window decorations -> $GTK_THEME (its own xfwm4 assets)"
    else
        warn "window decorations: queued for the next Xfce login"
    fi
else
    warn "$GTK_THEME ships no xfwm4 decorations — titlebars stay stock"
    warn "  (deploy.sh --with-branding installs arc-theme, which does)"
fi

# ------------------------------------------------------- 1b. Xfce icon names
# Xfce asks for REVERSE-DNS icon names in two separate namespaces, and Luv-Void
# carries neither: its LAUNCHERS want org.xfce.terminalemulator,
# org.xfce.filemanager, org.xfce.webbrowser, org.xfce.appfinder, and its PANEL
# PLUGINS want org.xfce.panel.showdesktop, .directorymenu, .applicationsmenu.
# Anything unanswered falls back to a colourful stock theme in the middle of a
# mono desktop — the show-desktop button showed up as a cyan square in a live
# look. This is the nm-tray lesson again: alias the icon the app ACTUALLY
# REQUESTS, read out of its .desktop or its plugin, never guessed.
#
# The fix is an alias per name, pointing at the mono icon Luv-Void does carry, in
# every size directory that has one. Symlinks, relative, idempotent, and removed
# again by --remove — the theme belongs to the shared half, so this only ever
# adds names to it and never edits what is already there.
LUV="$SHARE/icons/Luv-Void"
alias_icon() {          # alias_icon WANTED_NAME EXISTING_MONO_NAME
    local want="$1" have="$2" f d n=0
    [ -d "$LUV" ] || return 0
    while IFS= read -r f; do
        d=$(dirname "$f")
        [ -e "$d/$want.svg" ] || ln -sf "$(basename "$f")" "$d/$want.svg"
        n=$((n + 1))
    done <<EOF
$(find "$LUV" -name "$have.svg" 2>/dev/null)
EOF
    [ "$n" -gt 0 ]
}
if [ -d "$LUV" ]; then
    _al=0
    alias_icon org.xfce.terminalemulator utilities-terminal && _al=$((_al + 1))
    alias_icon org.xfce.filemanager      system-file-manager && _al=$((_al + 1))
    alias_icon org.xfce.webbrowser       internet-web-browser && _al=$((_al + 1))
    alias_icon org.xfce.appfinder        edit-find && _al=$((_al + 1))
    # Panel PLUGINS use org.xfce.panel.* names, a separate namespace from the
    # launchers above and just as absent from Luv-Void. The show-desktop button
    # was the one thing still colourful in a live look: a cyan square in an
    # otherwise mono dock, because nothing answered its name.
    alias_icon org.xfce.panel.showdesktop      user-desktop && _al=$((_al + 1))
    alias_icon org.xfce.panel.directorymenu    folder && _al=$((_al + 1))
    alias_icon org.xfce.panel.applicationsmenu start-here && _al=$((_al + 1))
    # A theme with an icon-theme.cache is read FROM THAT CACHE, so files added
    # afterwards are invisible no matter how correct they are. This cost a round
    # of confusion: the aliases existed, the symlinks were valid, and GTK still
    # resolved org.xfce.panel.showdesktop to Xfce's own colourful icon in
    # hicolor — because Luv-Void's cache had been written by the shared half
    # moments earlier and did not list them. Refresh it, or the aliases above do
    # nothing at all.
    if [ -f "$LUV/icon-theme.cache" ] && command -v gtk-update-icon-cache >/dev/null 2>&1; then
        gtk-update-icon-cache -f -t "$LUV" >/dev/null 2>&1 \
            && ok "Luv-Void icon cache refreshed (else the aliases stay invisible)" \
            || warn "could not refresh the Luv-Void icon cache — icons may not apply"
    fi
    if [ "$_al" -gt 0 ]; then
        ok "$_al Xfce app icon name(s) aliased into Luv-Void (the dock was falling"
        printf '    back to a colourful stock set)\n'
    fi
else
    warn "Luv-Void is not built yet — run cachy-branding first for mono icons"
fi

# ------------------------------------------------------------------- 2. panel
# Xfce's own arrangement is kept: a top bar and a bottom dock is what Xfce sets
# up, it works, and cloning LXQt's single bar here would be changing the desktop
# rather than dressing it. Only the colour is ours.
#
# NOT VERIFIED LIVE: whether the panel repaints on this property alone or needs
# `xfce4-panel -r`. No restart is issued here on purpose — a panel restart in a
# session the user is working in is exactly the intrusiveness this project
# avoids, and a stale colour until next login is a far smaller cost.
# background-rgba is an ARRAY of four doubles, which the single-value setter
# above cannot express — so it gets its own call. Only on the live path: writing
# a typed array into the channel XML by hand is more machinery than a panel
# colour is worth, and a box being provisioned before its first login gets the
# colour when the applier is re-run inside the session.
xq xfce4-panel /panels/panel-1/background-style int 1     # 1 = solid colour
if $HAVE_XFCONF; then
    # 40,44,52 = graphite, as doubles in 0..1, with alpha 0.92 so the panel
    # sits against the wallpaper rather than cutting a hard band across it.
    if xfconf-query -c xfce4-panel -p /panels/panel-1/background-rgba -n \
            -t double -s 0.156 -t double -s 0.172 -t double -s 0.203 \
            -t double -s 0.92 2>/dev/null; then
        ok "panel background -> graphite"
    else
        warn "could not set the panel background colour (harmless; panel stays stock)"
    fi
else
    warn "panel colour skipped: it needs a live xfconf (re-run inside Xfce)"
fi

# xfdesktop shows file/launcher icons by default (Home, Filesystem, Trash, and
# one per mounted volume). The LXQt applier already clears the desktop for the
# same two reasons, and a live look confirmed both on Xfce: the SYSTEM telemetry
# sheet lives down the left edge and the icons land straight on top of it, and a
# clean desktop is the look. 0 = none, 1 = minimised windows, 2 = file icons.
xq xfce4-desktop /desktop-icons/style int 0 && \
    ok "desktop icons cleared (they collided with the SYSTEM panel)"

# panel_drop PANEL TYPE... — remove every plugin of the given type(s) from a
# panel. Removing an Xfce plugin is two steps: reset the plugin AND rewrite the
# panel's plugin-ids array, or the bar keeps a gap where the item used to be.
# Written as a function because the owner asked for three of these in a row.
panel_drop() {
    local panel="$1"; shift
    local t id drop="" keep=""
    for t in "$@"; do
        for id in $(xfconf-query -c xfce4-panel -p "/panels/panel-$panel/plugin-ids" 2>/dev/null | tail -n +3); do
            [ "$(xfconf-query -c xfce4-panel -p "/plugins/plugin-$id" 2>/dev/null)" = "$t" ] \
                && drop="$drop $id"
        done
    done
    [ -n "$drop" ] || return 1
    for id in $(xfconf-query -c xfce4-panel -p "/panels/panel-$panel/plugin-ids" 2>/dev/null | tail -n +3); do
        case " $drop " in *" $id "*) ;; *) keep="$keep -t int -s $id" ;; esac
    done
    [ -n "$keep" ] || return 1
    # shellcheck disable=SC2086
    xfconf-query -c xfce4-panel -p "/panels/panel-$panel/plugin-ids" -n $keep 2>/dev/null || return 1
    for id in $drop; do
        xfconf-query -c xfce4-panel -p "/plugins/plugin-$id" -r 2>/dev/null
    done
    return 0
}

# updater_launcher_icon — an absolute PNG path for the dock launcher.
#
# The launcher plugin would not render the updater's SVG by absolute path: it
# fell back to Xfce's generic settings gear, which the owner spotted as "xfce
# default setting icons instead of the cachy void updater icon". The menu button
# right above it DOES load an absolute path — but a PNG (the one the shared half
# renders) — so raster works where the SVG did not. Rather than diagnose the
# panel's SVG loading, render a PNG once and point at that; it also matches how
# the wallpaper is handled here.
updater_launcher_icon() {
    local src="$ASSETS/void-cachy-updater.svg"
    local png="$SHARE/cachy-void/void-cachy-updater.png"
    [ -f "$src" ] || { printf '%s' "$src"; return; }
    if [ ! -s "$png" ]; then
        mkdir -p "$(dirname "$png")"
        if command -v magick >/dev/null 2>&1; then
            magick -background none "$src" -resize 64x64 "$png" 2>/dev/null
        elif command -v convert >/dev/null 2>&1; then
            convert -background none "$src" -resize 64x64 "$png" 2>/dev/null
        fi
    fi
    [ -s "$png" ] && printf '%s' "$png" || printf '%s' "$src"
}

# ------------------------------------------------------------ 2b. panel items
# Three owner-requested changes to Xfce's own panel. Note the shift: everything
# above only RECOLOURS what Xfce set up, while this edits its layout — asked for
# after seeing it, which is the only reason it is in scope. Each one is
# idempotent and each is undone by --remove.
if $HAVE_XFCONF; then
    # (a) The Applications button: Xfce ships a generic icon and the word
    #     "Applications" (localised — it read "Programmer" on a Danish box). The
    #     brand square alone is what the other desktops show.
    #     Which asset matters: void-cachy-square.svg is the WALLPAPER motif
    #     (concentric square frames in grey) and at 22px it reads as a small grey
    #     box — the owner spotted it immediately as "not the same as the other
    #     desktops". The brand MARK is the green diamond, void-cachy-icon.svg,
    #     and LXQt's menu button uses exactly that (as the PNG the shared half
    #     renders). Prefer that same PNG so the two panels are identical, and
    #     fall back to the SVG.
    EMBLEM=""
    for _e in "$SHARE/cachy-void/void-cachy-icon.png" "$ASSETS/void-cachy-icon.svg"; do
        [ -f "$_e" ] && { EMBLEM="$_e"; break; }
    done
    if [ -n "$EMBLEM" ]; then
        xq xfce4-panel /plugins/plugin-1/button-icon string "$EMBLEM"
        xq xfce4-panel /plugins/plugin-1/show-button-title bool false
        ok "menu button -> the Cachy-Void mark ($(basename "$EMBLEM")), no label"
    else
        warn "brand mark not found — menu button left as Xfce set it"
    fi

    # (b) Unify the bars with the other desktops, all owner-requested after
    #     seeing them side by side: no workspace switcher (nothing here uses
    #     multiple workspaces), no username button (the `actions` plugin — LXQt
    #     and Plasma show tray + clock and nothing else), and none of the dock's
    #     separators. Panel-1's separators are deliberately KEPT: one of them is
    #     the expanding spacer that pushes the tray and clock to the right, and
    #     dropping those collapses the bar.
    #     Lock both bars. An UNLOCKED Xfce panel draws a move handle — the three
    #     dots the owner spotted beside the menu button — exactly as an unlocked
    #     LXQt panel draws grip dots, which is why the LXQt applier sets
    #     lockPanel=true. Same decision, same reason: a bar that advertises its
    #     own draggability looks unfinished.
    xq xfce4-panel /panels/panel-1/position-locked bool true
    xq xfce4-panel /panels/panel-2/position-locked bool true
    ok "panels locked (removes the move-handle dots)"

    panel_drop 1 pager   && ok "workspace switcher removed from the panel"
    panel_drop 1 actions && ok "username button removed (tray + clock, like the others)"
    panel_drop 2 separator && ok "dock separators removed"

    # (c) Put the updater in the dock. It is the program this project expects you
    #     to live with, and every other desktop here has it one click away.
    UPD=/usr/share/applications/cachy-updater.desktop
    # Is one already there? Idempotency alone is not enough: an earlier version of
    # this applier created the directory WITHOUT the items array, so "already
    # present" would have meant "permanently broken". Find it and repair it.
    _have=""
    for _d in "$CFG"/xfce4/panel/launcher-*; do
        [ -f "$_d/cachy-updater.desktop" ] && { _have="${_d##*launcher-}"; break; }
    done
    if [ -f "$UPD" ] && [ -n "$_have" ]; then
        _ico=$(updater_launcher_icon)
        sed -i "s|^Icon=.*|Icon=$_ico|" \
            "$CFG/xfce4/panel/launcher-$_have/cachy-updater.desktop" 2>/dev/null
        if xfconf-query -c xfce4-panel -p "/plugins/plugin-$_have/items" \
                -n -t string -s cachy-updater.desktop 2>/dev/null; then
            ok "updater already in the dock (items + icon re-asserted)"
        fi
    elif [ -f "$UPD" ]; then
        _next=$(( $(xfconf-query -c xfce4-panel -p /panels/panel-2/plugin-ids 2>/dev/null | tail -n +3 | sort -n | tail -1) + 1 ))
        mkdir -p "$CFG/xfce4/panel/launcher-$_next"
        cp -f "$UPD" "$CFG/xfce4/panel/launcher-$_next/cachy-updater.desktop"
        sed -i "s|^Icon=.*|Icon=$(updater_launcher_icon)|" \
            "$CFG/xfce4/panel/launcher-$_next/cachy-updater.desktop"
        _ids=""
        for _id in $(xfconf-query -c xfce4-panel -p /panels/panel-2/plugin-ids 2>/dev/null | tail -n +3); do
            _ids="$_ids -t int -s $_id"
        done
        # shellcheck disable=SC2086
        # The `items` array is what makes a launcher a launcher. Without it the
        # plugin renders a generic gear and does nothing when clicked — which is
        # precisely what the first attempt produced, since creating the directory
        # and the .desktop is only half the job.
        if [ -n "$_ids" ] &&
           xfconf-query -c xfce4-panel -p /plugins/plugin-$_next -n -t string -s launcher 2>/dev/null &&
           xfconf-query -c xfce4-panel -p /plugins/plugin-$_next/items -n -t string -s cachy-updater.desktop 2>/dev/null &&
           xfconf-query -c xfce4-panel -p /panels/panel-2/plugin-ids -n $_ids -t int -s "$_next" 2>/dev/null; then
            ok "Cachy-Void updater added to the dock"
        else
            warn "could not add the updater to the dock"
            rm -rf "$CFG/xfce4/panel/launcher-$_next"
        fi
    fi
fi

# --------------------------------------------------------------- 3. wallpaper
# Same wallpaper, same order of preference, as every other desktop here. Picking
# a different one per desktop was a real bug once: they are meant to be the same
# desktop.
WALL=""
for w in "$ASSETS/wallpapers/cachy-void-official.svg" \
         "$ASSETS/wallpapers/void-cachy-flow.svg" \
         "$ASSETS/wallpapers/void-cachy-hex.svg"; do
    [ -f "$w" ] && { WALL="$w"; break; }
done
PNG="$SHARE/cachy-void/wallpaper-xfce.png"
if [ -n "$WALL" ] && { command -v magick >/dev/null 2>&1 || command -v convert >/dev/null 2>&1; }; then
    mkdir -p "$(dirname "$PNG")"
    GEO=$(xrandr 2>/dev/null | awk '/\*/ {print $1; exit}'); [ -n "$GEO" ] || GEO=1920x1080
    if command -v magick >/dev/null 2>&1; then
        magick -background none "$WALL" -resize "$GEO^" -gravity center -extent "$GEO" "$PNG" 2>/dev/null
    else
        convert -background none "$WALL" -resize "$GEO^" -gravity center -extent "$GEO" "$PNG" 2>/dev/null
    fi
    [ -s "$PNG" ] || PNG="$WALL"
else
    PNG="$WALL"
fi

if [ -n "$PNG" ]; then
    # The backdrop property path contains the MONITOR NAME, so it cannot be
    # written blind — the same shape of trap as Plasma's per-containment
    # wallpaper. With a live X server the monitors are enumerable; without one
    # they are not, so that case arms a one-shot autostart that re-runs this
    # applier at first login, which is the trick the Plasma applier already uses.
    MONS=""
    command -v xrandr >/dev/null 2>&1 && \
        MONS=$(xrandr --listmonitors 2>/dev/null | awk 'NR>1 {print $NF}')
    if [ -n "$MONS" ]; then
        _fw=$XQ_FAILED
        for m in $MONS; do
            xq xfce4-desktop "/backdrop/screen0/monitor$m/workspace0/last-image" string "$PNG"
            xq xfce4-desktop "/backdrop/screen0/monitor$m/workspace0/image-style" int 5   # 5 = zoomed
        done
        if [ "$XQ_FAILED" -eq "$_fw" ]; then
            ok "wallpaper -> $(basename "$PNG") on: $(echo "$MONS" | tr '\n' ' ')"
        else
            warn "wallpaper: queued for the next Xfce login"
        fi
    else
        warn "no X server here, so the monitors cannot be named — the wallpaper is"
        warn "  applied by the first-login one-shot instead"
        arm_first_login
    fi
else
    warn "no wallpaper asset found under $ASSETS/wallpapers"
fi

# ---------------------------------------------------------------- 4. terminal
# The colour scheme file itself is a SYSTEM asset (deploy.sh installs it beside
# the qterminal one, for the same reason: xfce4-terminal reads schemes from
# /usr/share, and a per-user copy is not offered in its dialog). What is written
# here is the applied palette, so the look is present without anyone opening a
# preferences window and picking it.
mkdir -p "$CFG/xfce4/terminal"
TRC="$CFG/xfce4/terminal/terminalrc"
[ -f "$TRC" ] && [ ! -f "$TRC.pre-cachy.bak" ] && cp -f "$TRC" "$TRC.pre-cachy.bak"
{
    printf '[Configuration]\n'
    printf 'ColorForeground=%s\n' "$FG"
    printf 'ColorBackground=%s\n' "$BG"
    printf 'ColorCursor=%s\n' "$ACCENT"
    printf 'ColorBold=%s\n' "$FG"
    printf 'ColorBoldUseDefault=FALSE\n'
    # One Dark family, matching the qterminal void-tactical scheme so a user who
    # meets both terminals meets one palette.
    printf 'ColorPalette=%s\n' "#1b1d1e;#e06c75;#98c379;#e5c07b;#61afef;#c678dd;#56b6c2;#abb2bf;#5c6370;#e06c75;#98c379;#e5c07b;#61afef;#c678dd;#56b6c2;#ffffff"
    printf 'FontUseSystem=TRUE\n'
    printf 'MiscMenubarDefault=FALSE\n'
    printf 'ScrollingUnlimited=TRUE\n'
} > "$TRC"
ok "xfce4-terminal -> void-tactical palette (font follows the xsettings mono font)"

# ------------------------------------------------------------ 4b. tray applets
# LXQt provides volume and removable-media as PANEL PLUGINS; Xfce's stock panel
# has neither, so its tray looked sparse next to the others (owner: "we have a
# usb and a sound icon top right on the other DEs"). The bare-Openbox session
# already solves this by starting the standalone equivalents, so Xfce uses the
# same two — gated to Xfce, started only if installed, and never a second copy:
# each gets ONE autostart entry, which is the nm-tray double-icon lesson.
mkdir -p "$CFG/autostart"
for _pair in "pasystray:volume" "udiskie:removable media"; do
    _bin=${_pair%%:*}; _what=${_pair#*:}
    if command -v "$_bin" >/dev/null 2>&1; then
        _args=""; [ "$_bin" = "udiskie" ] && _args=" -t"
        printf '[Desktop Entry]\nType=Application\nName=Cachy-Void %s (%s)\nExec=%s%s\nOnlyShowIn=XFCE;\nX-GNOME-Autostart-enabled=true\n' \
            "$_what" "$_bin" "$_bin" "$_args" \
            > "$CFG/autostart/cachy-void-$_bin-xfce.desktop"
        ok "$_what tray applet ($_bin) autostarted in Xfce"
        # Start it now too, but only in our own session and only if absent.
        if $LIVE && ! pgrep -x "$_bin" >/dev/null 2>&1; then
            # shellcheck disable=SC2086
            setsid --fork "$_bin" $_args >/dev/null 2>&1 </dev/null
        fi
    else
        warn "$_bin not installed — no $_what icon in the tray"
        warn "  (deploy.sh --with-branding installs it)"
    fi
done

# ------------------------------------------------------------------- 5. conky
# The two panels are shared (cachy-branding's apply_conky writes the configs and
# the launcher that waits for the screen geometry to settle). All that is needed
# per desktop is a gated autostart entry, exactly as LXQt and Plasma have.
LAUNCH="$SHARE/cachy-void/conky-start.sh"
if [ -x "$LAUNCH" ] && command -v conky >/dev/null 2>&1; then
    mkdir -p "$CFG/autostart"
    printf '[Desktop Entry]\nType=Application\nName=Cachy-Void telemetry (conky)\nExec=%s\nOnlyShowIn=XFCE;\nX-GNOME-Autostart-enabled=true\n' \
        "$LAUNCH" > "$CFG/autostart/cachy-void-conky-xfce.desktop"
    ok "conky telemetry autostart installed (the same two panels the others run)"
elif command -v conky >/dev/null 2>&1; then
    warn "conky is installed but the shared launcher is missing — run cachy-branding"
fi

# ----------------------------------------------------------- 5b. panel reload
# The panel caches the icon theme and its background at startup, so a live run
# leaves stock icons and a stock bar until the next login — which a real session
# made obvious. `xfce4-panel -r` is Xfce's OWN reload (what its settings tooling
# uses), takes under a second and keeps the layout, so unlike the plasmashell
# restart this one is cheap enough to be worth doing. Only in our own session:
# reloading a panel belonging to a desktop we are not in would be exactly the
# cross-session rudeness the $LIVE gate exists to prevent.
if $LIVE && command -v xfce4-panel >/dev/null 2>&1; then
    if xfce4-panel -r >/dev/null 2>&1; then
        ok "panel reloaded (icons + background applied now, layout untouched)"
    else
        warn "panel reload failed — its icons and colour land at the next login"
    fi
fi

# ------------------------------------------------------------------ 6. closing
log "Xfce applier done."
if [ "$XQ_FAILED" -gt 0 ]; then
    warn "$XQ_FAILED setting(s) could not be written (no live xfconf) — they are"
    warn "  queued for your next Xfce login by the one-shot armed above"
fi
if $LIVE; then
    printf '  Theme, icons, font and the panel apply immediately.\n'
    printf '  The Conky panels start with the session, so they appear at the next login\n'
    printf '  (or run ~/.local/share/cachy-void/conky-start.sh to see them now).\n'
else
    printf '  Config written. Log into Xfce to see it.\n'
fi
printf '  Xfce keeps its own panel layout, file manager and notifications on purpose:\n'
printf '  this dresses the desktop rather than replacing what it already does well.\n'
