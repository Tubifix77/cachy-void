#!/bin/sh
# cachy-game — Cachy-Void game launch wrapper (architecture.md §3.4).
#
# Composes the per-game runtime optimisations into one prefix:
#   gamemoderun -> prime-run -> <game>
# i.e. run the game under Feral GameMode (performance governor + GPU perf +
# nice/ionice for its lifetime) AND on the discrete GPU via the NVIDIA PRIME
# offload. Each layer is applied ONLY if present, so this is correct on:
#   * an Optimus laptop (both prime-run and gamemoderun)  -> gamemoderun prime-run game
#   * a desktop dGPU (no prime-run)                       -> gamemoderun game
#   * a box without gamemode                              -> game (or prime-run game)
#
# Everything beyond the base composition is OPT-IN via env toggles, so the
# wrapper stays invisible unless asked for (§3.4):
#   CACHY_HUD=1   MangoHud overlay (Vulkan/GL layer keyed on MANGOHUD=1)
#   CACHY_GS=1    gamescope micro-compositor (frame limiting / FSR; needs Vulkan);
#                 extra flags via CACHY_GS_OPTS, e.g. "-W 1920 -H 1080 -r 60 -f"
#   CACHY_VKB=1   vkBasalt post-processing (keyed on ENABLE_VKBASALT=1; its CAS
#                 sharpening pairs well with gamescope's FSR upscaling)
#
# Steam per-title launch option:      cachy-game %command%
# With the HUD:                       CACHY_HUD=1 cachy-game %command%
# Gamescope'd at 1080p60:             CACHY_GS=1 CACHY_GS_OPTS="-W 1920 -H 1080 -r 60" cachy-game %command%
# From a shell:                       cachy-game ./mygame
if [ "${CACHY_HUD:-0}" = 1 ]; then
    export MANGOHUD=1
    # A Proton/Steam-Runtime game runs inside a pressure-vessel CONTAINER whose
    # /etc is its own — the host's /etc/xdg/MangoHud/MangoHud.conf is NOT visible
    # there, so MangoHud would fall back to its built-in defaults (which show GPU
    # stats — misleading on legacy Optimus, §3.4). Only $HOME is bind-mounted into
    # the container, so seed the per-user config from the Cachy-Void system profile
    # ONCE (never clobber a config the user already has), making the intended
    # profile reach Proton games too.
    _ucfg="${XDG_CONFIG_HOME:-$HOME/.config}/MangoHud/MangoHud.conf"
    if [ ! -f "$_ucfg" ] && [ -f /etc/xdg/MangoHud/MangoHud.conf ]; then
        mkdir -p "${_ucfg%/*}" 2>/dev/null && cp /etc/xdg/MangoHud/MangoHud.conf "$_ucfg" 2>/dev/null || true
    fi
fi

[ "${CACHY_VKB:-0}" = 1 ] && export ENABLE_VKBASALT=1

# gamescope is the INNERMOST prefix (closest to the game): prime-run's offload
# env then covers gamescope AND the game, and gamemode governs the whole tree.
if [ "${CACHY_GS:-0}" = 1 ] && command -v gamescope >/dev/null 2>&1; then
    # shellcheck disable=SC2086 — CACHY_GS_OPTS is deliberately word-split
    set -- gamescope ${CACHY_GS_OPTS:-} -- "$@"
fi
command -v prime-run   >/dev/null 2>&1 && set -- prime-run "$@"
command -v gamemoderun >/dev/null 2>&1 && set -- gamemoderun "$@"

exec "$@"
