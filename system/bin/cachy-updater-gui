#!/usr/bin/env python3
"""Cachy-Void Updater — graphical front-end.

A clickable updater so updates actually happen (a terminal command gets skipped,
and skipped updates = driver/perf left on the floor). It's a thin PyQt5 shell over
the tested `cachy-void-update` CLI: every action runs the CLI via QProcess with
live output, so nothing blocks the window and privilege stays inside the CLI's
existing sudo-NOPASSWD boundary.

Sections mirror the update model (architecture.md §4/§7/§8). Both update buttons
run Stage 1 first (--sync, rebasing void-packages) so builds see current upstream
templates — the same --sync + --commit pairing the §4.9 scheduled runs use:
  * Update      — sync, then system + performance overlay   (--sync; --commit --no-kernel)
  * Kernel      — sync, then full commit incl. BORE kernel  (--sync; --commit)
  * Clean up    — remove orphans + clean the package cache  (--clean)
  * GPU         — detected card, driver, DKMS health (read-only)    (--gpu)
The "Check" button runs `--status` and shows the read-only overview.

BORE pin (§8.3a): when --status reports "BORE pin: MISSING" for this box's
kernel series, a notice card + "Review & pin…" button appear. The button
previews the proposal (--pin-bore --dry-run), shows it in a confirm dialog —
that dialog IS the human trust approval — and only then writes the pin
(--pin-bore --yes). Kernel updates stay paused until then; userspace never is.

LOOK: the window paints itself from the canonical void-tactical palette
(branding.md §2) instead of trusting the ambient Qt theme. It used to inherit
whatever the session provided, which meant a light-mode Fusion window whenever
the platform theme wasn't loaded (e.g. launched over SSH, or on a box installed
without --with-branding). The palette is the brand and is dark by definition, so
it is applied unconditionally — one appearance everywhere, no env dependency.
"""
import os
import re
import shutil
import sys
import time

from PyQt5.QtCore import QProcess, Qt, QTimer
from PyQt5.QtGui import QFont, QIcon
from PyQt5.QtWidgets import (
    QApplication, QDialog, QFrame, QGroupBox, QHBoxLayout, QLabel, QMessageBox,
    QPlainTextEdit, QProgressBar, QPushButton, QSizePolicy, QTextBrowser,
    QVBoxLayout, QWidget,
)

CLI = shutil.which("cachy-void-update") or "/usr/local/bin/cachy-void-update"
ICON = "/usr/share/cachy-void/branding/void-cachy-updater.svg"

# --- canonical void-tactical palette (branding.md §2 — single source of truth) --
BG = "#1b1d1e"        # obsidian
PANEL = "#282c34"     # graphite
FG = "#abb2bf"        # grey-white
ACCENT = "#478061"    # "the Void" green
FG_DIM = "#5c6370"    # muted text
WARN = "#967940"      # muted brass amber — indicator/border only
ON_ACCENT = BG

STYLE = f"""
QWidget {{ background: {BG}; color: {FG}; }}
QLabel#title {{ font-size: 16px; font-weight: bold; color: {FG}; }}
QLabel#subtitle {{ color: {FG_DIM}; }}

QGroupBox {{
    border: 1px solid {PANEL}; border-radius: 6px;
    margin-top: 16px; padding: 10px 8px 8px 8px;
}}
QGroupBox::title {{
    subcontrol-origin: margin; subcontrol-position: top left;
    left: 10px; padding: 0 5px; color: {ACCENT}; font-weight: bold;
}}

QPlainTextEdit {{
    background: {BG}; color: {FG};
    border: 1px solid {PANEL}; border-radius: 4px; padding: 6px;
    selection-background-color: {ACCENT}; selection-color: {ON_ACCENT};
}}

QPushButton {{
    background: {PANEL}; color: {FG};
    border: 1px solid #343a45; border-radius: 5px; padding: 7px 14px;
}}
QPushButton:hover {{ border-color: {ACCENT}; }}
QPushButton:pressed {{ background: #20242b; }}
QPushButton:disabled {{ color: {FG_DIM}; border-color: #23272e; }}

/* A utility, not an action: the check already ran on open and re-runs after
   every command, so this must not compete with the real buttons. Quieter than
   a real button — dim text, no fill — but it keeps a thin border, because
   without one nobody can tell it is clickable at all. */
QPushButton#quiet {{
    background: transparent; color: {FG_DIM};
    border: 1px solid #333a44; border-radius: 4px; padding: 4px 10px;
}}
QPushButton#quiet:hover {{ color: {ACCENT}; border-color: {ACCENT}; }}
QPushButton#quiet:pressed {{ color: {FG}; background: #20242b; }}
QPushButton#quiet:disabled {{ color: #3a4050; border-color: #262b33; }}

QPushButton#primary {{
    background: {ACCENT}; color: {ON_ACCENT};
    border: 1px solid {ACCENT}; font-weight: bold;
}}
QPushButton#primary:hover {{ background: #4f8f6c; border-color: #4f8f6c; }}
QPushButton#primary:disabled {{
    background: #2f4a3b; color: #7d8a83; border-color: #2f4a3b;
}}

QFrame#notice {{
    background: {PANEL}; border: 1px solid #333a44;
    border-left: 3px solid {WARN}; border-radius: 5px;
}}
QFrame#notice QLabel {{ background: transparent; }}
QLabel#noticeIcon {{
    color: {WARN}; font-size: 20px; font-weight: bold; padding: 0 2px;
}}
QLabel#noticeText {{ color: {FG}; }}

/* The headline answers the only question this window exists for: should I
   press Update? So it is the largest text in the pane, on purpose. */
QLabel#headline {{ color: {ACCENT}; font-size: 13px; font-weight: bold; }}
QLabel#headlineQuiet {{ color: {FG_DIM}; font-size: 13px; }}

/* Informational sibling of the notice card: same shape, accent instead of
   amber, because "a kernel is waiting for its trial boot" is news, not a
   problem. Amber here would read as "something is wrong" and train the user
   to ignore the colour that means exactly that. */
QFrame#infoNotice {{
    background: {PANEL}; border: 1px solid #333a44;
    border-left: 3px solid {ACCENT}; border-radius: 5px;
}}
QFrame#infoNotice QLabel {{ background: transparent; }}
QLabel#infoNoticeIcon {{
    color: {ACCENT}; font-size: 18px; font-weight: bold; padding: 0 2px;
}}

QProgressBar {{ background: {PANEL}; border: none; border-radius: 3px; }}
QProgressBar::chunk {{ background: {ACCENT}; border-radius: 3px; }}

/* Unstyled scrollbars render as bright stepper squares that stand out more
   than the content they scroll — flatten them into the panel. */
QScrollBar:vertical {{
    background: transparent; width: 10px; margin: 2px 2px 2px 0;
}}
QScrollBar:horizontal {{
    background: transparent; height: 10px; margin: 0 2px 2px 2px;
}}
QScrollBar::handle {{ background: #3a4050; border-radius: 5px; min-height: 24px; }}
QScrollBar::handle:hover {{ background: {ACCENT}; }}
QScrollBar::add-line, QScrollBar::sub-line {{ height: 0; width: 0; border: none; }}
QScrollBar::add-page, QScrollBar::sub-page {{ background: transparent; }}

/* the round "i" — available even mid-run (reading is never a mutation) */
QPushButton#info {{
    background: transparent; color: {FG_DIM};
    border: 1px solid #343a45; border-radius: 11px;
    min-width: 22px; max-width: 22px; min-height: 22px; max-height: 22px;
    padding: 0; font-weight: bold; font-style: italic;
}}
QPushButton#info:hover {{ color: {ACCENT}; border-color: {ACCENT}; }}

QTextBrowser {{
    background: {BG}; color: {FG};
    border: 1px solid {PANEL}; border-radius: 4px; padding: 10px;
    selection-background-color: {ACCENT}; selection-color: {ON_ACCENT};
}}

QMessageBox {{ background: {BG}; }}
QMessageBox QLabel {{ color: {FG}; }}
QToolTip {{
    background: {PANEL}; color: {FG}; border: 1px solid {ACCENT}; padding: 4px;
}}
"""


# --------------------------------------------------------------------------
# Help text ("i" button)
# --------------------------------------------------------------------------
# Written in GENERAL terms on purpose: it describes the *kinds* of things each
# tier covers, never a package list, so adding packages to the overlay never
# makes it wrong. The identity-defining specifics are named — BORE, 1000 Hz,
# -O3 / x86-64-v3 — because those are the point of the project, not inventory.
# It is anchored to the same tier numbers the status pane prints, so it teaches
# this window instead of restating it.
HELP_HTML = f"""
<h3 style="color:{ACCENT}; margin:0 0 6px 0;">What this updater does</h3>
<p>Cachy-Void is a <b>performance overlay for Void Linux</b>. Your base system
stays upstream Void; the overlay adds tuning, a curated set of locally compiled
packages, and (optionally) a BORE kernel. This updater keeps both current,
grouped the way the pending list is:</p>

<p><b style="color:{FG}">[1] System (upstream Void)</b><br>
Everything installed from Void's own binary repositories — desktop, drivers,
applications, libraries — exactly as Void ships them. <b>Update</b> brings these
current.</p>

<p><b style="color:{FG}">[2] Performance overlay</b><br>
A small curated set of performance-critical packages that this machine
<i>compiles locally</i> instead, tuned for your CPU (<code>-O3</code>, the
highest <code>x86-64-v*</code> level your hardware supports). Local builds share
version numbers with the upstream copies, so <b>Update</b> also makes sure the
locally built ones are the ones actually installed.</p>

<p><b style="color:{FG}">[3] Kernel — linux-cachy / BORE</b><br>
An optional kernel built here from Void's own kernel template plus the
<b>BORE</b> scheduler patch (steadier responsiveness under load), at 1000&nbsp;Hz
with full preemption. <b>Update kernel</b> syncs, verifies the BORE patch against
a checksum <i>you</i> approved, builds it, and installs it <i>alongside</i> your
stock kernel — you keep booting the known-good one until the new one proves
healthy. Because BORE comes from outside Void, a human approves it once per
kernel series: that is the <i>Review&nbsp;&amp;&nbsp;pin</i> notice, and until it
is done the kernel simply stays paused while everything else still updates.</p>

<p><b style="color:{FG}">[4] Maintenance</b><br>
Orphaned packages and the downloaded-package cache — <b>Clean up</b> reclaims
that space, and that is <i>all</i> it removes. Kernels are never deleted here:
not by <b>Clean up</b>, not by any other button, because a kernel that boots
fine today can still fail next week on something you have not done yet, and
rebuilding one takes hours. Leftover kernels are only <i>reported</i> — with
their size, and labelled by role (your rollback target, the running one, or a
mere spare) — each carrying the exact <code>vkpurge</code> command to remove it
yourself. If spares start piling up you also get a warning. Deleting a kernel
stays your decision, never the updater's.</p>

<p><b style="color:{FG}">Boot known-good kernel</b><br>
Appears only when the kernel you are running is not the one recorded as
known-good. It re-points the bootloader's default at that known-good kernel —
nothing is uninstalled, and a reboot applies it.</p>

<p><b style="color:{FG}">[5] GPU &amp; drivers</b><br>
Your graphics driver is an ordinary Void package, so <b>Update</b> keeps it
current along with everything else — this section tells you whether one is
waiting. It also reports which card was detected, which driver version is
installed, whether the kernel module is actually loaded, and whether
out-of-tree modules (NVIDIA's, for example) have been rebuilt for the kernel
you are running. Those rebuilds happen on their own whenever a kernel is
installed — Void's own DKMS hook does it, not this updater — so this is where
you confirm it worked, and it prints the rebuild command if one is missing.</p>

<p><b style="color:{FG}">[6] Flatpak apps</b><br>
If Flatpak is installed, its apps are refreshed as part of <b>Update</b>.</p>

<h3 style="color:{ACCENT}; margin:12px 0 6px 0;">What needs you, and what doesn't</h3>
<ul>
<li>Tiers 1, 2, 4 and 6 need no attention — press <b>Update</b>.</li>
<li>Tier 3 runs unattended <i>within</i> a kernel series; a new series needs one
approval (the notice tells you, and nothing else is blocked meanwhile).</li>
<li>The overlay's own files — this window, the tuning, the scripts — are updated
by refreshing the Cachy-Void repository and re-running its installer, not by
these buttons.</li>
</ul>

<p style="color:{FG_DIM}">Every button here runs the same tested command-line
updater; nothing in this window has privileges of its own. Reboots are only ever
needed for a new kernel.</p>
"""


# Wrapping rule for the headline. The first attempt glued every space inside a
# clause, which stopped "mesa" being orphaned from "26.1.8" but made a long
# clause UNBREAKABLE — with both a mesa and an nvidia update pending it could
# not wrap at all and would push the window wider (owner asked what happens
# when both need updating; that is what happens).
#
# So glue only the atoms that are nonsense when split: a package name from its
# version, and the short quoted button name. Everything else wraps normally, so
# a busy machine simply uses a second and third line.
_ATOM_RE = re.compile(r"([A-Za-z][\w.+-]*) (\d[\w.+-]*)")


def _glue_atoms(text: str) -> str:
    text = _ATOM_RE.sub(lambda m: f"{m.group(1)}\u00a0{m.group(2)}", text)
    return text.replace('"Update kernel" button', '"Update\u00a0kernel"\u00a0button')


class Updater(QWidget):
    def __init__(self):
        super().__init__()
        self.proc = None
        self.setWindowTitle("Cachy-Void Updater")
        self.setWindowIcon(QIcon(ICON))
        self.setStyleSheet(STYLE)
        self.resize(820, 700)

        root = QVBoxLayout(self)
        root.setContentsMargins(14, 14, 14, 12)
        root.setSpacing(10)

        # -- header: mark + title/subtitle + the read-only check ---------------
        header = QHBoxLayout()
        header.setSpacing(10)
        if os.path.exists(ICON):
            mark = QLabel()
            pm = QIcon(ICON).pixmap(30, 30)
            if not pm.isNull():
                mark.setPixmap(pm)
                header.addWidget(mark, 0, Qt.AlignVCenter)
        titles = QVBoxLayout()
        titles.setSpacing(0)
        title = QLabel("Cachy-Void Updater")
        title.setObjectName("title")
        subtitle = QLabel("System, performance overlay & BORE kernel")
        subtitle.setObjectName("subtitle")
        titles.addWidget(title)
        titles.addWidget(subtitle)
        header.addLayout(titles)
        header.addStretch(1)
        self.btn_help = QPushButton("i")
        self.btn_help.setObjectName("info")
        self.btn_help.setToolTip("What does this updater actually do?")
        self.btn_help.clicked.connect(self.show_help)
        header.addWidget(self.btn_help, 0, Qt.AlignVCenter)
        root.addLayout(header)

        # -- BORE-pin notice card (§8.3a) --------------------------------------
        # Hidden unless --status reports a missing trust pin. Styled per the
        # branding rules: --warn is the border/icon only, the message is --fg.
        self.notice = QFrame()
        self.notice.setObjectName("notice")
        nb = QHBoxLayout(self.notice)
        nb.setContentsMargins(12, 10, 12, 10)
        nb.setSpacing(10)
        icon = QLabel("⚠")
        icon.setObjectName("noticeIcon")
        icon.setAlignment(Qt.AlignTop)
        self.pin_label = QLabel(
            "Kernel updates are paused — the BORE patch for this kernel series "
            "has not been approved yet. Reviewing it once unpauses them.")
        self.pin_label.setObjectName("noticeText")
        self.pin_label.setWordWrap(True)
        # '&&' — a single '&' would be swallowed as a Qt mnemonic and render as
        # "Review _pin…" (caught by actually looking at a render).
        self.btn_pin = QPushButton("Review && pin…")
        self.btn_pin.setToolTip(
            "Fetch the BORE patch for your kernel series, show what was found "
            "(commit, file, checksum), and record it once you approve")
        self.btn_pin.setSizePolicy(QSizePolicy.Fixed, QSizePolicy.Fixed)
        nb.addWidget(icon, 0, Qt.AlignVCenter)
        nb.addWidget(self.pin_label, 1)
        nb.addWidget(self.btn_pin, 0, Qt.AlignVCenter)
        root.addWidget(self.notice)

        # -- staged-kernel notice (§8.6) ---------------------------------------
        # A kernel that is built, installed and waiting for its trial boot is a
        # state the user is LIVING in; until now it existed only in a state file.
        # No button belongs here on purpose: the updater never reboots anyone,
        # so the card informs and stops. The text (including which fallback
        # applies on this host) comes straight from --status, so the CLI stays
        # the single source of truth.
        self.kernel_notice = QFrame()
        self.kernel_notice.setObjectName("infoNotice")
        kb = QHBoxLayout(self.kernel_notice)
        kb.setContentsMargins(12, 10, 12, 10)
        kb.setSpacing(10)
        kicon = QLabel("ℹ")      # U+2139: has a glyph where U+23F1 does not
        kicon.setObjectName("infoNoticeIcon")
        self.kernel_label = QLabel()
        self.kernel_label.setObjectName("noticeText")
        self.kernel_label.setWordWrap(True)
        kb.addWidget(kicon, 0, Qt.AlignVCenter)
        kb.addWidget(self.kernel_label, 1)
        self.kernel_notice.hide()
        root.addWidget(self.kernel_notice)
        self.notice.hide()

        # -- status overview (read-only --status output) ------------------------
        status_box = QGroupBox("What's pending")
        sb = QVBoxLayout(status_box)
        sb.setContentsMargins(8, 6, 8, 8)

        # Snapshot age + re-check live INSIDE this group, because they describe
        # this pane and nothing else. Floating them up in the window header made
        # them look like stray text parked at a random spot; the check itself is
        # automatic (on open, and after every command), so this pair is only for
        # a window left open a long time.
        meta = QHBoxLayout()
        meta.setSpacing(8)
        # The headline: the single fact that decides whether you press Update.
        # It used to exist only as the first line of a scrolling monospace dump,
        # which is a strange place to keep the answer to the window's whole
        # question — the TRAY made that number prominent and the window did not
        # (owner's observation). Left of the re-check row, so it sits directly
        # above the detail it summarises and is read first.
        self.headline = QLabel("")
        self.headline.setObjectName("headline")
        self.headline.setWordWrap(True)
        meta.addWidget(self.headline, 1)
        meta.addStretch(0)
        self.checked_at = QLabel("")
        self.checked_at.setObjectName("subtitle")
        self.btn_check = QPushButton("Re-check for updates")
        self.btn_check.setObjectName("quiet")
        self.btn_check.setToolTip(
            "Read the pending list again (read-only). Runs by itself when this "
            "window opens and after every command.")
        meta.addWidget(self.checked_at, 0, Qt.AlignVCenter)
        meta.addWidget(self.btn_check, 0, Qt.AlignVCenter)
        sb.addLayout(meta)

        self.status = QPlainTextEdit(readOnly=True)
        self.status.setPlaceholderText("Click 'Check for updates' to see what's pending…")
        sb.addWidget(self.status)
        # The status IS the content of this window — it used to be squeezed into a
        # scrolled sliver under an empty Output box (renders don't lie).
        root.addWidget(status_box, 5)

        # -- actions: one primary, the rest secondary --------------------------
        actions = QHBoxLayout()
        actions.setSpacing(8)
        self.btn_update = QPushButton("Update")
        self.btn_update.setObjectName("primary")
        self.btn_update.setToolTip(
            "Update the system and rebuild the performance overlay "
            "(leaves the kernel alone)")
        self.btn_kernel = QPushButton("Update kernel")
        self.btn_kernel.setToolTip(
            "Everything, including the BORE kernel — compiles, then needs a reboot")
        # Recovery, shown only when there is something to go back TO (the CLI
        # says so in --status). Until now rollback existed only as a CLI flag,
        # which is exactly the wrong place for the one action you want when a
        # kernel misbehaves.
        self.btn_rollback = QPushButton("Boot known-good kernel")
        self.btn_rollback.setToolTip(
            "Pin the bootloader default back to the last kernel known to work. "
            "Nothing is uninstalled; a reboot applies it.")
        self.btn_clean = QPushButton("Clean up")
        self.btn_clean.setToolTip(
            "Remove orphaned packages and clean the package cache. "
            "Never removes kernels.")
        self.btn_gpu = QPushButton("GPU / drivers")
        self.btn_gpu.setToolTip("Detected card, driver status, DKMS health (read-only)")
        # Snapshots were taken before every update from the start, and there was
        # no way to SEE them here - a safety net nobody can find is reached for
        # only after it was needed. Read-only: it lists them and prints the
        # restore commands for this machine; it never restores anything itself.
        self.btn_snapshots = QPushButton("Snapshots")
        self.btn_snapshots.setToolTip(
            "Snapshots taken before past updates, what each one was for, and "
            "how to go back to one on this machine (read-only)")
        actions.addWidget(self.btn_update)
        actions.addWidget(self.btn_kernel)
        actions.addWidget(self.btn_rollback)
        actions.addStretch(1)
        actions.addWidget(self.btn_clean)
        actions.addWidget(self.btn_snapshots)
        actions.addWidget(self.btn_gpu)
        root.addLayout(actions)
        self.btn_rollback.hide()

        # -- live command output -----------------------------------------------
        out_box = QGroupBox("Output")
        ob = QVBoxLayout(out_box)
        ob.setContentsMargins(8, 6, 8, 8)
        self.out = QPlainTextEdit(readOnly=True)
        self.out.setPlaceholderText(
            "Output from the running command appears here…")
        self.out.setMinimumHeight(130)
        ob.addWidget(self.out)
        root.addWidget(out_box, 2)

        # activity strip: heartbeat label + pulsing bar. Long stretches of an
        # update produce no output (downloads, unpacking); without a visible
        # "still alive" signal the app reads as crashed.
        activity = QHBoxLayout()
        self.act_label = QLabel("")
        self.act_label.setObjectName("subtitle")
        self.act_bar = QProgressBar()
        self.act_bar.setRange(0, 0)          # indeterminate pulse
        self.act_bar.setTextVisible(False)
        self.act_bar.setFixedHeight(6)
        activity.addWidget(self.act_label, 1)
        activity.addWidget(self.act_bar, 2)
        root.addLayout(activity)
        self.act_label.hide(); self.act_bar.hide()
        self._act_timer = QTimer(self)
        self._act_timer.setInterval(1000)
        self._act_timer.timeout.connect(self._tick)
        self._act_msg = ""; self._act_secs = 0

        # snapshot age: the pending list is a point-in-time read, so say when it
        # was taken rather than letting a stale pane look authoritative.
        self._checked_at = None
        self._age_timer = QTimer(self)
        self._age_timer.setInterval(30000)
        self._age_timer.timeout.connect(self._refresh_age)
        self._age_timer.start()

        mono = QFont("Hack"); mono.setStyleHint(QFont.Monospace)
        mono.setPointSize(9)
        self.status.setFont(mono); self.out.setFont(mono)

        self.btn_check.clicked.connect(self.check)
        self.btn_update.clicked.connect(self.update_userspace)
        self.btn_kernel.clicked.connect(self.update_kernel)
        self.btn_clean.clicked.connect(self.clean)
        self.btn_gpu.clicked.connect(self.gpu)
        self.btn_snapshots.clicked.connect(self.snapshots)
        self.btn_pin.clicked.connect(self.pin_bore)
        self.btn_rollback.clicked.connect(self.rollback)

        self._buttons = (self.btn_check, self.btn_update, self.btn_kernel,
                         self.btn_clean, self.btn_gpu, self.btn_snapshots,
                         self.btn_pin, self.btn_rollback)
        self.check()  # populate on open

    # -- process plumbing -------------------------------------------------
    def _busy(self, yes):
        for b in self._buttons:
            b.setEnabled(not yes)

    def _tick(self):
        self._act_secs += 1
        m, s = divmod(self._act_secs, 60)
        self.act_label.setText(f"{self._act_msg}  ({m}:{s:02d})")

    def _activity(self, msg):
        if msg:
            self._act_msg = msg; self._act_secs = 0
            self.act_label.setText(msg)
            self.act_label.show(); self.act_bar.show()
            self._act_timer.start()
        else:
            self._act_timer.stop()
            self.act_label.hide(); self.act_bar.hide()

    def _run(self, args, target, *, done=None, confirm=None, busy_msg=None,
             activity=None, clear=True):
        if self.proc and self.proc.state() != QProcess.NotRunning:
            return
        if confirm and QMessageBox.question(
                self, "Confirm", confirm,
                QMessageBox.Yes | QMessageBox.No, QMessageBox.No) != QMessageBox.Yes:
            return
        if clear:
            target.clear()
        # show a "working…" line while the CLI runs (a --status probe can take
        # ~15s); it's replaced the moment real output arrives (_drain).
        if busy_msg:
            target.setPlainText(busy_msg)
        self._clear_on_output = bool(busy_msg)
        self._busy(True)
        self._activity(activity or "Working…")
        self.proc = QProcess(self)
        self.proc.setProcessChannelMode(QProcess.MergedChannels)
        self.proc.readyRead.connect(lambda: self._drain(target))

        def _on_error(err):
            # if the CLI can't even start, finished() won't fire — un-busy here
            if err == QProcess.FailedToStart:
                self._append_tail(target,
                    f"[could not run {CLI} — is the updater installed? "
                    "(deploy.sh installs it)]")
                self._busy(False)
                self._activity(None)
        self.proc.errorOccurred.connect(_on_error)
        self.proc.finished.connect(lambda code, _st: self._finished(target, code, done))
        self.proc.start(CLI, args)

    def _append_tail(self, target, text):
        """Append, keeping the view on the newest line — in BOTH panes.

        One rule, deliberately. An earlier version split the behaviour (Output
        followed its tail while the pending list was pinned to its first line) on
        the theory that a status document should be read top-down. In practice
        that just moved the complaint from one pane to the other: the pending
        list is taller than its pane, so its last tiers sat permanently out of
        sight, and it read as the same bug having changed windows. Owner's call
        (2026-08-19): text you just wrote is text you want to see — both panes
        follow.

        The exception stays: if you have scrolled up to read something, nothing
        yanks you back down."""
        bar = target.verticalScrollBar()
        before = bar.value()
        at_bottom = before >= bar.maximum() - 4
        target.appendPlainText(text)
        if at_bottom:
            bar.setValue(bar.maximum())      # follow the newest line
        else:
            bar.setValue(before)             # a reader is mid-scroll: leave them


    def _drain(self, target):
        chunk = bytes(self.proc.readAll()).decode("utf-8", "replace")
        if chunk:
            if getattr(self, "_clear_on_output", False):
                target.clear()
                self._clear_on_output = False
            self._append_tail(target, chunk.rstrip("\n"))

    def _finished(self, target, code, done):
        self._busy(False)
        self._activity(None)
        self._append_tail(target, f"\n— done (exit {code}) —")
        if done:
            done(code)

    def _sync_then(self, commit_args, *, confirm, activity):
        """Stage 1 (--sync: rebase void-packages) before a commit, as one click.

        Builds must see CURRENT upstream templates — without the sync, a kernel
        run would port whatever stale template the checkout happens to hold. The
        §4.9 scheduled runs already pair --sync + --commit; the buttons do the
        same instead of expecting users to know a CLI-only stage. A failed sync
        aborts the chain (nothing has been changed at that point)."""
        def after_sync(code):
            if code == 0:
                self._run(commit_args, self.out, clear=False,
                          done=lambda _c: self.check(), activity=activity)
            else:
                self._append_tail(self.out,
                    "[sync failed — update aborted; nothing was changed]")
        self._run(["--sync"], self.out, confirm=confirm, done=after_sync,
                  activity="Syncing build templates (git rebase)…")

    # -- help -------------------------------------------------------------
    def show_help(self):
        """Explain the update model. Deliberately NON-modal and outside the
        busy-lock: the most likely moment to wonder "what is it doing?" is
        while it is doing it, and reading can never mutate anything."""
        dlg = getattr(self, "_help_dlg", None)
        if dlg is not None:
            dlg.show(); dlg.raise_(); dlg.activateWindow()
            return
        dlg = QDialog(self)
        dlg.setWindowTitle("About Cachy-Void updates")
        dlg.setStyleSheet(STYLE)
        dlg.resize(660, 620)
        lay = QVBoxLayout(dlg)
        lay.setContentsMargins(12, 12, 12, 12)
        body = QTextBrowser()
        body.setOpenExternalLinks(False)
        body.setHtml(HELP_HTML)
        lay.addWidget(body)
        row = QHBoxLayout()
        row.addStretch(1)
        close = QPushButton("Close")
        close.clicked.connect(dlg.hide)
        row.addWidget(close)
        lay.addLayout(row)
        self._help_dlg = dlg
        dlg.show()

    # -- snapshot age -----------------------------------------------------
    @staticmethod
    def _age_text(seconds):
        """Human age of the pending snapshot (pure — unit-tested)."""
        if seconds is None:
            return ""
        if seconds < 90:
            return "checked just now"
        minutes = int(seconds // 60)
        if minutes < 60:
            return f"checked {minutes} minute{'s' if minutes != 1 else ''} ago"
        hours = minutes // 60
        return f"checked {hours} hour{'s' if hours != 1 else ''} ago"

    def _refresh_age(self):
        if self._checked_at is None:
            self.checked_at.setText("")
            return
        self.checked_at.setText(self._age_text(time.time() - self._checked_at))

    # -- actions ----------------------------------------------------------
    def check(self):
        def done(_code):
            self._checked_at = time.time()
            self._refresh_age()
            self._update_pin_banner()
        self._run(["--status"], self.status, busy_msg="Getting Cachy-Void status…",
                  activity="Checking for updates…", done=done)

    def _update_pin_banner(self):
        """Show the §8.3a notice iff --status flagged a missing trust pin
        (keyed on the CLI's stable "BORE pin: MISSING" marker), the rollback
        button iff there is a different known-good kernel to go to, and the
        staged-kernel card iff a candidate is waiting (marker: "kernel
        candidate:")."""
        text = self.status.toPlainText()
        self.notice.setVisible("BORE pin: MISSING" in text)
        self.btn_rollback.setVisible("rollback available" in text)
        self._update_headline(text)
        self._update_kernel_notice(text)

    def _update_headline(self, text):
        """Summarise --status into one line: what is waiting, and nothing else.

        Reads the CLI's own output rather than re-querying, for the same reason
        the kernel card does — one source of truth, and no way for the headline
        and the detail beneath it to disagree.
        """
        parts = []
        m = re.search(r"(\d+) upstream package\(s\) updatable", text)
        n = int(m.group(1)) if m else 0
        if n:
            held = re.search(r"\(\+(\d+) on hold\)", text)
            parts.append(f"{n} package{'' if n == 1 else 's'} to update"
                         + (f" ({held.group(1)} on hold)" if held else ""))
        m = re.search(r"(\d+) to rebuild, (\d+) to deploy", text)
        if m:
            rb, dep = int(m.group(1)), int(m.group(2))
            if rb:
                parts.append(f"{rb} overlay package{'' if rb == 1 else 's'} to rebuild")
            elif dep:
                parts.append(f"{dep} to deploy")
        # Three attempts to get one clause right, each failing a reader test the
        # owner applied: "a graphics driver update" said nothing; "new mesa
        # 26.1.8_1" assumed you know what mesa is; and both read as a SEPARATE
        # item carrying an instruction ("restart apps to use it") for a driver
        # not installed yet — "use what?" was the exact, fair reply.
        #
        # So: the driver is a HIGHLIGHT FROM WITHIN the package count, phrased
        # as part of the same sentence, and it gives no instruction at all. What
        # to do afterwards is printed after the update, when it is actionable.
        drivers = [f"{pkg} {ver.split('_')[0]}" for pkg, ver in re.findall(
            r"graphics driver update: (\S+) \S+ -> (\S+) ", text)]
        if drivers and parts:
            parts[0] += ", including a new graphics driver (" + \
                        ", ".join(drivers) + ")"
        elif drivers:
            parts.append("a new graphics driver (" + ", ".join(drivers) + ")")
        # The kernel is the one thing Update genuinely will NOT do, so the
        # clause names the button that does — otherwise it sits beside the
        # others looking like something the same press would handle.
        if "port linux-cachy" in text:
            parts.append('a newer BORE kernel to build — the "Update kernel" button')
        m = re.search(r"(\d+) app\(s\) updatable", text)
        if m and int(m.group(1)):
            parts.append(f"{m.group(1)} Flatpak app(s)")

        if parts:
            self.headline.setText(_glue_atoms("  ·  ".join(parts)))
            self.headline.setObjectName("headline")
        else:
            self.headline.setText("Everything is up to date")
            self.headline.setObjectName("headlineQuiet")
        # Qt re-reads the stylesheet for a widget only when its style is
        # repolished; changing objectName alone changes nothing visible.
        self.headline.style().unpolish(self.headline)
        self.headline.style().polish(self.headline)

    def _update_kernel_notice(self, text):
        """Lift the CLI's "kernel candidate:" lines into the info card.

        Deliberately a *transcription*, not a re-derivation: the CLI already
        decided what is true for this host's boot class (one-shot fallback vs
        "pick it in the foreign menu"), and a second opinion computed in the GUI
        is how the two drift apart.
        """
        keep = []
        for line in text.splitlines():
            if line.strip().startswith("kernel candidate:"):
                keep = [line.strip()[len("kernel candidate:"):].strip()]
            elif keep and line.startswith("      ") and line.strip():
                keep.append(line.strip())      # the indented boot-class advice
            elif keep:
                break
        if keep:
            head = "Kernel " + keep[0]
            # One flowing paragraph: the label word-wraps, and the boot-class
            # advice belongs in the same breath as the kernel it applies to.
            # The CLI's sub-lines are lowercase clauses under a bullet, so they
            # get a sentence break here rather than being run on with a space.
            tail = " ".join(keep[1:]).strip()
            if tail:
                tail = ". " + tail[0].upper() + tail[1:]
            self.kernel_label.setText(head + tail)
        self.kernel_notice.setVisible(bool(keep))

    def rollback(self):
        self._run(["--rollback"], self.out, done=lambda _c: self.check(),
                  confirm="Boot the last known-good kernel from now on?\n\n"
                          "This only changes which kernel the bootloader starts "
                          "by default — nothing is uninstalled, and the current "
                          "kernel stays available. Reboot to apply it.",
                  activity="Pinning the known-good kernel…")

    def pin_bore(self):
        """Two-step assisted pin: preview (--dry-run), human-approve in a
        dialog — that dialog IS the §8.3 trust vouch — then write (--yes)."""
        def after_preview(code):
            if code != 0:
                self._append_tail(self.out,
                    "[could not locate the BORE patch — see above; you can "
                    "pin manually per INSTALL.md §6.2]")
                return
            text = self.out.toPlainText()
            proposal = text[text.rfind("Proposed BORE pin"):].strip() or text
            if QMessageBox.question(
                    self, "Approve BORE patch pin",
                    "This is the trust decision for your kernel's BORE patch. "
                    "Approving records the checksum below; every future kernel "
                    "build verifies the patch against it.\n\n" + proposal +
                    "\n\nPin this patch?",
                    QMessageBox.Yes | QMessageBox.No,
                    QMessageBox.No) != QMessageBox.Yes:
                self._append_tail(self.out, "[not pinned — nothing was written]")
                return
            self._run(["--pin-bore", "--yes"], self.out, clear=False,
                      done=lambda _c: self.check(),
                      activity="Writing the BORE trust pin…")
        self._run(["--pin-bore", "--dry-run"], self.out, done=after_preview,
                  activity="Fetching the BORE patch for review…")

    def update_userspace(self):
        # userspace only — the kernel is the explicit "Update kernel" button
        self._sync_then(["--commit", "--yes", "--no-kernel"],
                  confirm="Update the system and rebuild the performance overlay now?"
                          "\n\n(The BORE kernel is left alone — use 'Update kernel' "
                          "for that.)",
                  activity="Updating — do not power off")

    def update_kernel(self):
        # full commit: userspace + the BORE kernel (compiles, reboot-gated)
        self._sync_then(["--commit", "--yes"],
                  confirm="Update everything, including the BORE kernel, now?\n\nThis "
                          "compiles the kernel (can take a while) and a reboot is "
                          "needed to switch to it.",
                  activity="Updating incl. kernel compile — do not power off")

    def clean(self):
        """Preview, then confirm with the actual list — never a blind sweep.

        Agreeing to "remove orphans and clean the cache" is agreeing to a
        category, not to a decision: an orphan list can contain something you
        depend on (a runtime-only library nothing links), and the cache holds
        the older package versions a downgrade would need. So the dialog shows
        what would go, exactly like the BORE-pin flow."""
        def after_preview(code):
            if code != 0:
                self._append_tail(self.out,
                    "[could not preview the cleanup — nothing was removed]")
                return
            text = self.out.toPlainText()
            if "nothing to clean" in text:
                return
            if "REFUSING to remove orphans" in text:
                QMessageBox.warning(
                    self, "Cleanup needs a look first",
                    "Some orphaned packages were built by the overlay itself, so "
                    "the orphan sweep was skipped — removing them could break it "
                    "silently.\n\nSee the output for the exact command to keep "
                    "them, then run Clean up again.")
                return
            body = text[text.find("orphaned packages to remove:"):].strip() or text
            if QMessageBox.question(
                    self, "Confirm cleanup",
                    "This will remove the following and clean the obsolete "
                    "package cache. Old kernels are never touched.\n\n" + body +
                    "\n\nProceed?",
                    QMessageBox.Yes | QMessageBox.No,
                    QMessageBox.No) != QMessageBox.Yes:
                self._append_tail(self.out, "[cleanup cancelled — nothing removed]")
                return
            self._run(["--clean", "--yes"], self.out, clear=False,
                      done=lambda _c: self.check(), activity="Cleaning up…")
        self._run(["--clean", "--dry-run"], self.out, done=after_preview,
                  activity="Checking what can be cleaned…")

    def gpu(self):
        self._run(["--gpu"], self.out,   # read-only advisory, no confirm
                  activity="Reading GPU / driver state…")

    def snapshots(self):
        # Read-only, so no confirm - and deliberately NOT a one-click restore:
        # changing which subvolume the machine boots is a decision, and this
        # shows the commands so the person whose machine it is makes it.
        self._run(["--snapshots"], self.out,
                  activity="Reading snapshots…")


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Cachy-Void Updater")
    app.setDesktopFileName("cachy-updater")
    win = Updater()
    win.show()
    sys.exit(app.exec_())


if __name__ == "__main__":
    main()
