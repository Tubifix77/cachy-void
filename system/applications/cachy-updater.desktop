[Desktop Entry]
Type=Application
Version=1.0
Name=Cachy-Void Updater
GenericName=System Updater
Comment=Update the system, performance overlay, and BORE kernel
# No QT_QPA_PLATFORMTHEME here on purpose: every session we support sets it
# itself (LXQt and the Openbox session to lxqt, Plasma to its own), and
# hardcoding lxqt forced LXQt's platform theme onto Plasma - wrong icons and
# dialogs in a session that had already made the right choice.
Exec=env QT_STYLE_OVERRIDE=kvantum cachy-updater-gui
Icon=/usr/share/cachy-void/branding/void-cachy-updater.svg
Terminal=false
Categories=System;Settings;PackageManager;
Keywords=update;upgrade;packages;kernel;driver;cachy;void;
StartupNotify=true
